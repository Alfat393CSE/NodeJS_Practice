  <%- include("partials/head") %>
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <%- include("partials/nav") %>
    <!-- Success Section -->
    <main
      class="flex min-h-[calc(100vh-137px)] items-center justify-center px-6"
    >
      <div
        class="w-full max-w-lg rounded-2xl border border-slate-800 bg-slate-900 p-10 text-center shadow-xl"
      >
        <!-- Success Icon -->
        <div
          class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-emerald-500/10"
        >
          <span class="text-4xl font-bold text-emerald-400">✓</span>
        </div>
        <!-- Content -->
        <h1 class="mt-6 text-3xl font-bold text-white">Thank You!</h1>
        <p class="mt-3 text-lg font-medium text-slate-300">
          We will contact you soon.
        </p>
        <p class="mx-auto mt-3 max-w-md text-slate-400">
          Your house details have been submitted successfully. We have received
          your information.
        </p>
        <!-- Home Button -->
        <a
          href="/"
          class="mt-8 inline-block rounded-xl bg-indigo-500 px-7 py-3 font-semibold text-white shadow-lg shadow-indigo-500/20 transition hover:bg-indigo-400"
        >
          ← Go to Home
        </a>
      </div>
    </main>
    <!-- Footer -->
    <footer
      class="border-t border-slate-800 py-6 text-center text-sm text-slate-500"
    >
      © 2026 Alfat. All rights reserved.
    </footer>
  </body>
</html>
